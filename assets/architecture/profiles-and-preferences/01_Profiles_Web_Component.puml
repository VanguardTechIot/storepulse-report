@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()

skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Web Application Component View - Profiles and Preferences

Container_Boundary(webApplication, "Web Application") {
    Component(profilesUI, "Profiles UI", "Angular", "Displays the profile editor, the language selector and the notification settings.")
    Component(profilesService, "Profiles Service", "Angular Service", "Consumes the profile and notification preference REST endpoints.")
}

Container(restApi, "REST API", "ASP.NET Core, .NET", "Monolithic API that centralizes StorePulse business logic.")

Rel(profilesUI, profilesService, "Uses")
Rel(profilesService, restApi, "Consumes profile and preference services", "HTTPS/JSON")

@enduml
