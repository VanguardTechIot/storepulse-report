@startuml storepulse-service-monitoring-web-component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Service Execution and Monitoring - Web Components

Container_Boundary(webApp, "Web Application - Angular") {

    Component(telemetryDashboard, "TelemetryDashboard", "Angular View", "Shows the monitoring status of each location and its latest measurements.")

    Component(consumptionView, "ConsumptionView", "Angular View", "Shows the consumption of each period and compares it with the historical baseline.")

    Component(monitoringStore, "MonitoringStore", "Angular Signals Store", "Keeps the telemetry, consumption and monitored resources used by the views.")

    Component(monitoringApi, "MonitoringApi", "Angular Service", "Groups the telemetry and consumption endpoints of the REST API.")

    Component(endpoints, "TelemetryApiEndpoint / ConsumptionApiEndpoint", "Angular HttpClient", "Requests the REST resources and converts them into domain entities.")
}

Container(restApi, "REST API", "Java, Spring Boot", "Provides telemetry and consumption services.")

Rel(telemetryDashboard, monitoringStore, "Reads")

Rel(consumptionView, monitoringStore, "Reads")

Rel(monitoringStore, monitoringApi, "Loads data through")

Rel(monitoringApi, endpoints, "Uses")

Rel(endpoints, restApi, "Requests /telemetry and /consumption", "HTTPS/JSON")

@enduml
