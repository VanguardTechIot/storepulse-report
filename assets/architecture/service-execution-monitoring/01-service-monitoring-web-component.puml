@startuml storepulse-service-monitoring-web-component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Service Execution and Monitoring - Web Components

Container_Boundary(webApp, "Web Application - Angular") {

    Component(monitoringUI, "Monitoring UI", "Angular", "Provides dashboards for telemetry, measurements, consumption and alerts.")

    Component(monitoringService, "Monitoring Service", "Angular Service", "Consumes REST endpoints for monitoring and alert information.")
}

Container(restApi, "REST API", "ASP.NET Core, .NET", "Monolithic backend that centralizes StorePulse business logic.")

Rel(monitoringUI, monitoringService, "Uses")

Rel(monitoringService, restApi, "Consumes monitoring services", "HTTPS/JSON")

@enduml