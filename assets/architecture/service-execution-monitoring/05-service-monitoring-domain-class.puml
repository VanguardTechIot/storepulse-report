@startuml storepulse-service-monitoring-domain

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Service Execution and Monitoring - Domain Layer Class Diagram

package "Telemetry and Measurement" {

    class Telemetry <<Aggregate Root>> {
        - id: Long
        - deviceId: Long
        - receivedAt: Instant
        - measurements: List<Measurement>
        + addMeasurement(type: MeasurementType, value: MeasurementValue, recordedAt: Instant): Measurement
        + getMeasurements(): List<Measurement>
        + hasMeasurements(): boolean
    }

    class Measurement <<Entity>> {
        - id: Long
        - type: MeasurementType
        - value: MeasurementValue
        - recordedAt: Instant
    }

    class MeasurementValue <<Value Object>> {
        - value: Double
    }

    enum MeasurementType {
        TEMPERATURE
        HUMIDITY
        ELECTRICITY
        WATER
        MOTION
        SMOKE
        + getUnit(): String
        + isConsumption(): boolean
    }

    class SensorStatus <<Value Object>> {
        - type: MeasurementType
        - value: Double
        - recordedAt: Instant
    }
}

package "Consumption" {

    class Consumption <<Aggregate Root>> {
        - id: Long
        - resourceId: Long
        - measurementType: MeasurementType
        - totalValue: Double
        - periodStart: Instant
        - periodEnd: Instant
        + addReading(value: Double): void
        + {static} periodOf(instant: Instant): YearMonth
        + {static} startOf(period: YearMonth): Instant
    }
}

package "Safety Evaluation" {

    class MeasurementEvaluation <<Value Object>> {
        - type: MeasurementType
        - deviceStatus: String
        - response: String
        - alertTriggered: boolean
    }

    class TelemetryRegistration <<Value Object>> {
        - telemetry: Telemetry
        - evaluations: List<MeasurementEvaluation>
    }
}

package "Repositories" {

    interface TelemetryRepository {
        + save(telemetry: Telemetry): Telemetry
        + findWithMeasurementsById(id: Long): Optional<Telemetry>
        + findByDeviceIdOrderByReceivedAtDesc(deviceId: Long): List<Telemetry>
        + findByDeviceIdInOrderByReceivedAtDesc(deviceIds: Collection<Long>): List<Telemetry>
    }

    interface ConsumptionRepository {
        + save(consumption: Consumption): Consumption
        + findByResourceIdAndMeasurementTypeAndPeriodStart(resourceId: Long, type: MeasurementType, periodStart: Instant): Optional<Consumption>
        + findByResourceIdOrderByPeriodStartAsc(resourceId: Long): List<Consumption>
        + findByResourceIdInOrderByPeriodStartAsc(resourceIds: Collection<Long>): List<Consumption>
    }
}

package "Domain Events" {

    class TelemetryReceivedEvent <<Domain Event>> {
        - deviceId: Long
        - occurredOn: Instant
    }

    class MeasurementRecordedEvent <<Domain Event>> {
        - deviceId: Long
        - type: MeasurementType
        - value: Double
        - occurredOn: Instant
    }

    class MotionDetectedEvent <<Domain Event>> {
        - deviceId: Long
        - occurredOn: Instant
    }

    class SmokeDetectedEvent <<Domain Event>> {
        - deviceId: Long
        - concentration: Double
        - occurredOn: Instant
    }

    class UtilityConsumptionRecordedEvent <<Domain Event>> {
        - deviceId: Long
        - type: MeasurementType
        - value: Double
        - occurredOn: Instant
    }
}

Telemetry "1" *-- "1..*" Measurement : contains
Measurement --> MeasurementValue
Measurement --> MeasurementType
Consumption --> MeasurementType
SensorStatus --> MeasurementType
TelemetryRegistration --> Telemetry
TelemetryRegistration "1" o-- "1..*" MeasurementEvaluation

TelemetryRepository ..> Telemetry : persists
ConsumptionRepository ..> Consumption : persists

Telemetry ..> TelemetryReceivedEvent : publishes
Telemetry ..> MeasurementRecordedEvent : publishes
Telemetry ..> MotionDetectedEvent : publishes
Telemetry ..> SmokeDetectedEvent : publishes
Telemetry ..> UtilityConsumptionRecordedEvent : publishes

@enduml
