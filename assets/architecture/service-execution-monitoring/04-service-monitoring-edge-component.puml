@startuml storepulse-service-monitoring-edge-component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Service Execution and Monitoring - Edge Components

Container_Boundary(edgeApi, "Edge API - Python Flask") {

    Component(telemetryEndpoint, "Telemetry Endpoint", "Flask Blueprint", "Receives the telemetry of the nodes at POST /api/v1/monitoring/telemetry.")

    Component(telemetryService, "TelemetryApplicationService", "Python", "Authenticates the node, validates and stores the telemetry, requests its evaluation and sends it to the REST API.")

    Component(iamFacade, "IamContextFacade", "Python", "Validates the identifier and API key of the node.")

    Component(safetyFacade, "SafetyContextFacade", "Python", "Evaluates each measurement against the local safety rules.")

    Component(telemetryRepository, "TelemetryRepository", "Python, Peewee", "Stores the telemetry locally until its synchronization is confirmed.")

    Component(backendClient, "BackendTelemetryClient", "Python, HTTP", "Sends the telemetry to the REST API with its original date.")

    Component(scheduler, "SynchronizationScheduler", "Python Thread", "Retries the pending telemetry and refreshes the safety rules periodically.")
}

Container(embeddedApplication, "Embedded Application", "C++, ESP32", "Reads the sensors and sends telemetry.")

ContainerDb(edgeDatabase, "Edge Local Database", "SQLite", "Stores telemetry pending synchronization.")

Container(restApi, "REST API", "Java, Spring Boot", "Registers the synchronized telemetry.")

Rel(embeddedApplication, telemetryEndpoint, "Sends telemetry with its API key", "HTTP/JSON")

Rel(telemetryEndpoint, telemetryService, "Invokes")

Rel(telemetryService, iamFacade, "Authenticates the node with")

Rel(telemetryService, safetyFacade, "Evaluates measurements with")

Rel(telemetryService, telemetryRepository, "Stores telemetry in")

Rel(telemetryService, backendClient, "Synchronizes through")

Rel(scheduler, telemetryService, "Retries pending telemetry")

Rel(telemetryRepository, edgeDatabase, "Reads and writes", "SQLite")

Rel(backendClient, restApi, "Sends telemetry", "HTTPS/JSON")

@enduml
