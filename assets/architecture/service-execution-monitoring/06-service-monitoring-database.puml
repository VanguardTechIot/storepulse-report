@startuml storepulse-service-monitoring-database

hide circle

skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Service Execution and Monitoring - Database Design

entity "telemetry" as telemetry {
    * id : BIGINT <<PK>>
    --
    device_id : BIGINT
    received_at : DATETIME(6)
    created_at : DATETIME(6)
    updated_at : DATETIME(6)
}

entity "measurements" as measurements {
    * id : BIGINT <<PK>>
    --
    telemetry_id : BIGINT <<FK>>
    type : ENUM
    measured_value : DOUBLE
    recorded_at : DATETIME(6)
}

entity "consumption" as consumption {
    * id : BIGINT <<PK>>
    --
    resource_id : BIGINT
    measurement_type : ENUM
    total_value : DOUBLE
    period_start : DATETIME(6)
    period_end : DATETIME(6)
    created_at : DATETIME(6)
    updated_at : DATETIME(6)
}

telemetry ||--o{ measurements : contains

@enduml
