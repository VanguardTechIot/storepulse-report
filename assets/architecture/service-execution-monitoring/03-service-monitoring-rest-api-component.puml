@startuml storepulse-service-monitoring-rest-api-component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Service Execution and Monitoring - REST API Components

Container_Boundary(restApi, "REST API - Spring Boot") {

    Component(telemetryController, "TelemetryController", "Spring REST Controller", "Receives telemetry from the Edge API and queries registered telemetry.")

    Component(consumptionController, "ConsumptionController", "Spring REST Controller", "Queries the consumption per period of the visible resources.")

    Component(sensorStatusController, "SensorStatusController", "Spring REST Controller", "Queries the latest reading of each sensor of a device or resource.")

    Component(monitoredResourcesController, "MonitoredResourcesController", "Spring REST Controller", "Queries the visible resources and their devices.")

    Component(commandServices, "TelemetryCommandServiceImpl", "Application Service", "Registers telemetry, accumulates consumption and requests the safety evaluation.")

    Component(queryServices, "Telemetry, Consumption and SensorStatus Query Services", "Application Services", "Process the monitoring queries.")

    Component(outboundServices, "External Resource Asset, Property Communication and Safety Services", "Anti-Corruption Layer", "Call the facades of other Bounded Contexts.")

    Component(monitoringFacade, "MonitoringContextFacade", "Context Facade", "Exposes the monthly consumption of resources to other Bounded Contexts.")

    Component(domainModel, "Service Execution and Monitoring Domain", "Domain Layer", "Contains Telemetry, Measurement, Consumption, value objects and domain events.")

    Component(repositories, "TelemetryRepository / ConsumptionRepository", "Spring Data JPA", "Persist telemetry, measurements and consumption.")
}

ContainerDb(database, "Database", "MySQL", "Stores telemetry, measurements and consumption.")

Container(edgeApi, "Edge API", "Python, Flask", "Sends the telemetry of the nodes.")

Container(otherContexts, "Resource and Asset Management, Property Communication, Safety and Emergencies", "Bounded Contexts", "Provide devices, visible resources and safety evaluations.")

Rel(edgeApi, telemetryController, "Sends telemetry to", "HTTPS/JSON")

Rel(telemetryController, commandServices, "Invokes")

Rel(telemetryController, queryServices, "Invokes")

Rel(consumptionController, queryServices, "Invokes")

Rel(sensorStatusController, queryServices, "Invokes")

Rel(monitoredResourcesController, outboundServices, "Invokes")

Rel(commandServices, domainModel, "Executes domain operations")

Rel(commandServices, outboundServices, "Uses")

Rel(queryServices, repositories, "Reads from")

Rel(commandServices, repositories, "Writes to")

Rel(monitoringFacade, queryServices, "Uses")

Rel(outboundServices, otherContexts, "Calls context facades of")

Rel(repositories, database, "Reads and writes", "Spring Data JPA")

@enduml
