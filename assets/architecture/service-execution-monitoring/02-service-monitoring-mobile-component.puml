@startuml storepulse-service-monitoring-mobile-component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Service Execution and Monitoring - Mobile Components

Container_Boundary(mobileApp, "Mobile Application - Flutter") {

    Component(monitoringPage, "MonitoringPage", "Flutter Widget", "Shows the consumption of the period, the status of the sensors and the consumption history of the store.")

    Component(monitoringViewModel, "MonitoringViewModel", "Cubit", "Loads the monitored locations and the data of the selected one.")

    Component(monitoringRepository, "MonitoringRepositoryImpl", "Dart Repository", "Builds the domain entities from the REST resources.")

    Component(monitoringService, "MonitoringService", "Dart HTTP Client", "Calls the monitoring endpoints with the session token.")
}

Container(restApi, "REST API", "Java, Spring Boot", "Provides monitored resources, consumption and sensor status services.")

Rel(monitoringPage, monitoringViewModel, "Observes state from")

Rel(monitoringViewModel, monitoringRepository, "Requests data from")

Rel(monitoringRepository, monitoringService, "Uses")

Rel(monitoringService, restApi, "Requests /monitored-resources, /consumption and /sensors/status", "HTTPS/JSON")

@enduml
