@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()

skinparam shadowing false
skinparam defaultFontName Arial

title Management-Tenant Communication - REST API Component View

' =========================================================
' EXTERNAL CONTAINERS
' =========================================================

Container(webApplication, "Web Application", "Web", "Web application of the Management-Tenant Communication bounded context.")
Container(mobileApplication, "Mobile Application", "Mobile", "Mobile application of the Management-Tenant Communication bounded context.")

' =========================================================
' REST API
' =========================================================

Container_Boundary(restApi, "REST API") {

    ' Controllers
    Component(tenantAssignmentsController, "Tenant Assignments Controller", "Controller", "Manages tenant assignments.")
    Component(communicationLogsController, "Communication Logs Controller", "Controller", "Manages communication logs.")
    Component(tenantNotificationsController, "Tenant Notifications Controller", "Controller", "Manages tenant notifications.")
    Component(conversationMessagesController, "Conversation Messages Controller", "Controller", "Manages conversation messages.")
    Component(conversationsController, "Conversations Controller", "Controller", "Manages conversations.")

    ' Application Layer
    Component(queryHandlers, "Query Handlers", "Application Handler", "Processes queries of the bounded context.")
    Component(assignmentCommandHandlers, "Assignment Command Handlers", "Command Handler", "Processes commands related to tenant assignments.")
    Component(conversationCommandHandlers, "Conversation Command Handlers", "Command Handler", "Processes commands related to conversations.")
    Component(notificationCommandHandlers, "Notification Command Handlers", "Command Handler", "Processes commands related to tenant notifications.")
    Component(logCommandHandlers, "Log Command Handlers", "Command Handler", "Processes commands related to communication logs.")

    ' Event Handlers
    Component(utilityBillIssuedEventHandler, "Utility Bill Issued Event Handler", "Event Handler", "Reacts to utility bill issued events.")
    Component(tenantNotifiedEventHandler, "Tenant Notified Event Handler", "Event Handler", "Reacts to tenant notification events.")

    ' Repositories
    Component(tenantAssignmentRepository, "Tenant Assignment Repository", "Repository", "Persists tenant assignments.")
    Component(conversationRepository, "Conversation Repository", "Repository", "Persists conversations.")
    Component(tenantNotificationRepository, "Tenant Notification Repository", "Repository", "Persists tenant notifications.")
    Component(communicationLogRepository, "Communication Log Repository", "Repository", "Persists communication logs.")

    ' Domain
    Component(tenantAssignmentAggregate, "Tenant Assignment Aggregate", "Aggregate", "Domain model for tenant assignments.")
    Component(conversationAggregate, "Conversation Aggregate", "Aggregate", "Domain model for conversations and messages.")
    Component(tenantNotificationAggregate, "Tenant Notification Aggregate", "Aggregate", "Domain model for tenant notifications.")
    Component(communicationLogAggregate, "Communication Log Aggregate", "Aggregate", "Domain model for communication logs.")

    ' Adapters
    Component(pushNotificationAdapter, "Push Notification Adapter", "Adapter", "Sends push notifications.")
    Component(emailNotificationAdapter, "Email Notification Adapter", "Adapter", "Sends notifications by email.")

    ' ACL / Facade
    Component(mtcFacade, "MTC Facade", "Facade", "Entry point for other bounded contexts.")
}

' =========================================================
' DATABASE
' =========================================================

ContainerDb(database, "Database", "MySQL", "Stores conversations, messages, notifications, assignments and communication logs.")

' =========================================================
' WEB APPLICATION -> CONTROLLERS
' =========================================================

Rel(webApplication, tenantAssignmentsController, "Gestiona asignaciones", "HTTPS/JSON")
Rel(webApplication, communicationLogsController, "Consulta registros de comunicación", "HTTPS/JSON")
Rel(webApplication, tenantNotificationsController, "Gestiona notificaciones", "HTTPS/JSON")
Rel(webApplication, conversationMessagesController, "Envía y consulta mensajes", "HTTPS/JSON")
Rel(webApplication, conversationsController, "Consulta y gestiona conversaciones", "HTTPS/JSON")

' =========================================================
' MOBILE APPLICATION -> CONTROLLERS
' =========================================================

Rel(mobileApplication, tenantNotificationsController, "Consulta notificaciones", "HTTPS/JSON")
Rel(mobileApplication, conversationMessagesController, "Envía y consulta mensajes", "HTTPS/JSON")
Rel(mobileApplication, conversationsController, "Consulta conversaciones", "HTTPS/JSON")

' =========================================================
' CONTROLLERS -> APPLICATION
' =========================================================

Rel(tenantAssignmentsController, assignmentCommandHandlers, "Despacha comandos")
Rel(communicationLogsController, queryHandlers, "Despacha consultas")
Rel(tenantNotificationsController, queryHandlers, "Despacha consultas")
Rel(tenantNotificationsController, notificationCommandHandlers, "Despacha comandos")
Rel(conversationMessagesController, queryHandlers, "Despacha consultas")
Rel(conversationMessagesController, conversationCommandHandlers, "Despacha comandos")
Rel(conversationsController, queryHandlers, "Despacha consultas")
Rel(conversationsController, conversationCommandHandlers, "Despacha comandos")

' =========================================================
' APPLICATION -> DOMAIN / REPOSITORIES
' =========================================================

Rel(assignmentCommandHandlers, tenantAssignmentAggregate, "Orquesta")
Rel(assignmentCommandHandlers, tenantAssignmentRepository, "Persiste")

Rel(conversationCommandHandlers, conversationAggregate, "Orquesta")
Rel(conversationCommandHandlers, conversationRepository, "Persiste")

Rel(notificationCommandHandlers, tenantNotificationAggregate, "Orquesta")
Rel(notificationCommandHandlers, tenantNotificationRepository, "Persiste")

Rel(logCommandHandlers, communicationLogAggregate, "Orquesta")
Rel(logCommandHandlers, communicationLogRepository, "Persiste")

' =========================================================
' QUERY HANDLERS -> REPOSITORIES
' =========================================================

Rel(queryHandlers, conversationRepository, "Consulta")
Rel(queryHandlers, tenantNotificationRepository, "Consulta")
Rel(queryHandlers, tenantAssignmentRepository, "Consulta")
Rel(queryHandlers, communicationLogRepository, "Consulta")

' =========================================================
' EVENT HANDLERS
' =========================================================

Rel(utilityBillIssuedEventHandler, notificationCommandHandlers, "Invoca notificación")
Rel(tenantNotifiedEventHandler, logCommandHandlers, "Invoca registro de log")

' =========================================================
' NOTIFICATION FLOW
' =========================================================

Rel(notificationCommandHandlers, pushNotificationAdapter, "Delega envío")
Rel(notificationCommandHandlers, emailNotificationAdapter, "Delega envío")
Rel(pushNotificationAdapter, mobileApplication, "Envía notificaciones push")

' =========================================================
' PERSISTENCE
' =========================================================

Rel(tenantAssignmentRepository, database, "Lee y escribe datos", "MySQL/SQL")
Rel(conversationRepository, database, "Lee y escribe datos", "MySQL/SQL")
Rel(tenantNotificationRepository, database, "Lee y escribe datos", "MySQL/SQL")
Rel(communicationLogRepository, database, "Lee y escribe datos", "MySQL/SQL")

' =========================================================
' ACL / FACADE
' =========================================================

Rel(mtcFacade, notificationCommandHandlers, "Traduce solicitudes externas")
@enduml