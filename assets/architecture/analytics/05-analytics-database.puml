@startuml storepulse-analytics-database

hide circle

skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Dashboard and Analytics - Database Design

entity "notifications" as notifications {
    * id : CHAR(36) <<PK>>
    --
    type : VARCHAR(30)
    related_entity_id : CHAR(36)
    message : VARCHAR(500)
    generated_at : DATETIME
    grouped_count : INT
}

entity "consumption_registrations" as consumptionRegistrations {
    * id : CHAR(36) <<PK>>
    --
    utility_type : VARCHAR(30)
    meter_id : CHAR(36)
    reading_value : DECIMAL(10,2)
    consumption_value : DECIMAL(10,2)
    unit : VARCHAR(20)
    period : VARCHAR(20)
    captured_at : DATETIME
    recorded_at : DATETIME
}

note bottom of consumptionRegistrations
  meter_id es una referencia externa al
  Bounded Context Resource and Assets
  Management (sin FK física entre contextos).
end note

@enduml
