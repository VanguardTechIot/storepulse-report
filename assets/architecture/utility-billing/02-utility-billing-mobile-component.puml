@startuml storepulse-utility-billing-mobile-component

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
skinparam shadowing false
skinparam defaultFontName Arial

title StorePulse - Utility Billing - Mobile Components

Container_Boundary(mobileApp, "Mobile Application - Flutter") {
    Component(utilityBillingUI, "Utility Billing UI", "Flutter / Dart", "Provides the interface for tenants to consult utility bills, billing breakdowns and submit billing disputes.")
    Component(utilityBillingService, "Utility Billing Service", "Flutter Service", "Consumes REST endpoints related to utility bills and billing disputes.")
}

Container(restApi, "REST API", "ASP.NET Core, .NET", "Monolithic backend that centralizes StorePulse business logic.")

Rel(utilityBillingUI, utilityBillingService, "Uses")
Rel(utilityBillingService, restApi, "Consumes utility billing services", "HTTPS/JSON")

@enduml
